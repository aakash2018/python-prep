- S3 bucket create karo
aws --endpoint-url=http://localhost:4566 s3 mb s3://my-test-bucket

- check s3 bucket
aws --endpoint-url=http://localhost:4566 s3 ls

- deploy build in s3 bucket
aws --endpoint-url=http://localhost:4566 s3 sync out s3://my-local-bucket (s3://my-local-bucket-> it is bucket name)

-delete build in s3 bucket
aws --endpoint-url=http://localhost:4566 \
  s3 sync out/ s3://next-local-bucket --delete


